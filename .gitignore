            <p>Comida rápida, entrega expressa e pagamentos sem complicação.</p>
            <div class="cta-row">
              <button class="primary-btn">Ver ofertas</button>
              <button class="secondary-btn">Novo pedido</button>
            </div>
          </div>

          <div class="hero-panel">
            <div class="metric-box">
              <strong>4.9</strong>
              <span>avaliação</span>
            </div>
            <div class="metric-box blue">
              <strong>20 min</strong>
              <span>média</span>
            </div>
            <div class="floating-card">
              <span>Entrega grátis</span>
              <strong>Brasil 2026</strong>
            </div>
          </div>
        </section>

        <section class="category-strip" id="categoryStrip"></section>

        <section class="section-row">
          <div class="section-header">
            <h3>Restaurantes perto de você</h3>
            <a href="#">Ver todos</a>
          </div>
          <div id="restaurantList" class="restaurant-list"></div>
        </section>

        <section class="section-row">
          <div class="section-header">
            <h3 id="catalogTitle">Menu do restaurante</h3>
            <a href="#">Filtrar por categoria</a>
          </div>
          <div id="foodGrid" class="food-grid"></div>
        </section>

        <section class="section-row stats-panel">
          <div class="stat-card">
            <span>Pedidos ativos</span>
            <strong id="activeOrders">328</strong>
          </div>
          <div class="stat-card">
