            <input id="searchInput" type="text" placeholder="Buscar restaurante, prato ou cozinha" />
          </div>
          <div class="top-actions">
            <div class="address-pill">
              <span class="dot green"></span>
              Centro • 1,4 km
            </div>
            <button class="icon-btn" aria-label="Notificações">🔔</button>
          </div>
        </header>

        <section class="hero">
          <div class="hero-copy">
            <span class="tiny-badge">Hoje em alta</span>
