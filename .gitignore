              Observações
              <textarea rows="3" placeholder="Sem cebola, molho à parte..."></textarea>
            </label>
          </div>

          <button type="submit" class="submit-btn">Pagar agora</button>
        </form>
      </div>
    </div>

    <div id="toast" class="toast"></div>

    <script src="/app.js"></script>
  </body>
</html>
`;

const css = `:root {
  --bg: #f5f3ef;
  --panel: #ffffff;
  --panel-alt: #fffaf5;
  --brand: #ff6b2c;
  --brand-dark: #d9531e;
  --brand-soft: #ffe7dc;
  --text: #1f1f1f;
  --muted: #727272;
  --muted-soft: #f0f0f0;
  --green: #2ecf72;
  --green-soft: #e9fff2;
  --shadow: 0 18px 45px rgba(30, 23, 18, 0.12);
  --radius: 24px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #fdf8f4 0%, #f4efe9 100%);
  color: var(--text);
}
button, input, textarea { font: inherit; }
button { cursor: pointer; border: 0; }
.app-shell {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr) 380px;
  min-height: 100vh;
  gap: 18px;
  padding: 18px;
}
.sidebar, .main-panel, .cart-panel {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(31, 31, 31, 0.04);
  border-radius: 30px;
  box-shadow: var(--shadow);
}
.sidebar {
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 6px 4px 18px;
}
.brand-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--brand) 0%, #ff8d5d 100%);
  color: white;
  font-weight: 900;
  font-size: 1.2rem;
}
.brand-row h1 { font-size: 1.3rem; margin: 0; }
.brand-row span { color: var(--muted); font-size: 0.8rem; }
.menu { display: grid; gap: 10px; }
.menu-btn {
  width: 100%;
  text-align: left;
  background: transparent;
  color: var(--text);
  font-weight: 600;
  padding: 12px 14px;
  border-radius: 14px;
  transition: 0.2s ease;
}
.menu-btn.active, .menu-btn:hover { background: var(--brand-soft); color: var(--brand-dark); }
.promo-box {
  padding: 18px 16px;
  background: linear-gradient(135deg, #ff8d5d 0%, var(--brand) 100%);
  color: white;
  border-radius: 24px;
}
.promo-label { margin: 0 0 12px; opacity: 0.8; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
.promo-box h3 { margin: 0; font-size: 1.6rem; }
.promo-box p { margin: 8px 0 0; opacity: 0.9; }
.promo-box button {
  margin-top: 14px;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.28);
  padding: 10px 14px;
  border-radius: 12px;
}
.status-card {
  background: var(--green-soft);
  border: 1px solid rgba(46, 207, 114, 0.1);
  color: #147b42;
  border-radius: 18px;
  padding: 16px;
  display: grid;
  gap: 6px;
}
.status-card p, .status-card span { margin: 0; }
.main-panel { padding: 20px; }
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--muted-soft);
  border-radius: 18px;
  padding: 14px 16px;
}
.search-box input {
  flex: 1;
  border: 0;
  background: transparent;
  outline: none;
  font-size: 0.96rem;
}
.top-actions { display: flex; align-items: center; gap: 12px; }
.address-pill {
  display: inline-flex; align-items: center; gap: 8px; background: #fff; padding: 12px 16px; border-radius: 12px; border: 1px solid rgba(31, 31, 31, 0.05); font-weight: 600;
}
.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.dot.green { background: var(--green); }
.icon-btn {
  width: 42px; height: 42px; display: grid; place-items: center; background: white; border-radius: 12px; border: 1px solid rgba(31, 31, 31, 0.05);
}
.hero {
  display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 18px; background: linear-gradient(135deg, #fff9f1 0%, #fff2ea 100%); border-radius: 28px; padding: 28px; margin-bottom: 20px; border: 1px solid rgba(255, 107, 44, 0.08);
}
.hero-copy { display: flex; flex-direction: column; justify-content: center; }
.tiny-badge {
  width: fit-content; padding: 8px 12px; border-radius: 999px; background: var(--brand-soft); color: var(--brand-dark); font-size: 0.78rem; font-weight: 700;
}
.hero-copy h2 { margin: 14px 0 8px; font-size: clamp(2rem, 3vw, 3rem); line-height: 1.1; }
.hero-copy p { margin: 0; color: var(--muted); font-size: 1rem; }
.cta-row { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 12px; }
.primary-btn, .secondary-btn, .checkout-btn, .submit-btn {
  border-radius: 14px; padding: 13px 18px; font-weight: 700;
}
.primary-btn, .checkout-btn, .submit-btn {
  background: linear-gradient(135deg, var(--brand) 0%, #ff8d5d 100%); color: white; box-shadow: 0 16px 30px rgba(255, 107, 44, 0.28);
}
.secondary-btn {
  background: white; color: var(--text); border: 1px solid rgba(31, 31, 31, 0.05);
}
.hero-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: end; }
.metric-box {
  background: white; padding: 18px 16px; border-radius: 20px; border: 1px solid rgba(31, 31, 31, 0.04); display: flex; flex-direction: column; gap: 8px;
}
.metric-box strong { font-size: 1.7rem; }
.metric-box span { color: var(--muted); }
.metric-box.blue { background: #ecf4ff; }
.floating-card {
  grid-column: 1 / -1; background: linear-gradient(135deg, #1d1d1d 0%, #383838 100%); color: white; border-radius: 22px; padding: 18px 20px; display: flex; flex-direction: column; justify-content: center; min-height: 110px;
}
.floating-card span { opacity: 0.8; }
.category-strip { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 22px; }
.category-pill {
  padding: 10px 14px; background: white; border-radius: 999px; border: 1px solid rgba(31, 31, 31, 0.05); color: var(--muted); font-weight: 600;
}
.category-pill.active { background: var(--brand-soft); color: var(--brand-dark); border-color: transparent; }
.section-row { margin-bottom: 20px; }
.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.section-header h3 { margin: 0; font-size: 1.4rem; }
.section-header a { text-decoration: none; color: var(--brand-dark); font-weight: 700; }
.restaurant-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.restaurant-card {
  background: white; border-radius: 24px; padding: 12px; border: 1px solid rgba(31, 31, 31, 0.04); transition: transform 0.2s ease, box-shadow 0.2s ease; text-align: left;
}
.restaurant-card:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(13, 17, 22, 0.08); }
.restaurant-card.active { border-color: rgba(255, 107, 44, 0.35); box-shadow: 0 12px 30px rgba(255, 107, 44, 0.08); }
.restaurant-cover { position: relative; height: 130px; border-radius: 20px; background-size: cover; background-position: center; overflow: hidden; }
.restaurant-cover .rating { position: absolute; top: 12px; right: 12px; background: rgba(255, 255, 255, 0.9); border-radius: 999px; padding: 6px 10px; font-weight: 700; font-size: 0.84rem; }
.restaurant-card-body { padding: 12px 4px 4px; }
.restaurant-card-body h4 { margin: 0 0 8px; font-size: 1.1rem; }
.restaurant-meta { display: flex; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 0.8rem; }
.food-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.food-card { background: white; border-radius: 24px; overflow: hidden; border: 1px solid rgba(31, 31, 31, 0.04); display: flex; flex-direction: column; }
.food-image { height: 170px; background-size: cover; background-position: center; }
.food-body { display: flex; flex-direction: column; gap: 10px; padding: 14px; flex: 1; }
.food-top { display: flex; justify-content: space-between; gap: 8px; }
.food-top h4 { margin: 0; font-size: 1.08rem; }
.tag { background: var(--brand-soft); color: var(--brand-dark); padding: 6px 8px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; }
.food-meta { color: var(--muted); font-size: 0.82rem; display: flex; justify-content: space-between; gap: 10px; }
.food-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; }
.price { font-size: 1.3rem; font-weight: 800; }
.add-btn { background: var(--brand-soft); color: var(--brand-dark); border-radius: 12px; padding: 10px 14px; font-weight: 700; }
.stats-panel { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.stat-card { background: white; border-radius: 20px; padding: 18px 16px; border: 1px solid rgba(31, 31, 31, 0.04); display: flex; flex-direction: column; gap: 8px; }
.stat-card span { color: var(--muted); }
.stat-card strong { font-size: 1.5rem; }
.cart-panel { padding: 20px 16px; display: flex; flex-direction: column; gap: 16px; }
.cart-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid rgba(31, 31, 31, 0.06); }
.cart-header p, .cart-header h3 { margin: 0; }
.cart-header h3 { margin-top: 4px; }
#cartCount { font-weight: 700; color: var(--muted); }
.address-box {
  background: #f9f7f5; padding: 14px 16px; border-radius: 16px; border: 1px solid rgba(31, 31, 31, 0.04); display: flex; flex-direction: column; gap: 4px;
}
.label { color: var(--muted); font-size: 0.8rem; }
.address-box small { color: var(--muted); }
.mode-switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); background: #f5f5f5; border-radius: 14px; padding: 4px; }
.mode-btn { background: transparent; padding: 10px 8px; border-radius: 10px; font-weight: 700; color: var(--muted); }
.mode-btn.active { background: white; color: var(--text); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08); }
.cart-items { display: grid; gap: 12px; min-height: 120px; }
.cart-item { display: flex; gap: 12px; background: #fff; border-radius: 18px; padding: 10px; border: 1px solid rgba(31, 31, 31, 0.04); }
.cart-thumb { width: 62px; height: 62px; border-radius: 14px; background-size: cover; background-position: center; }
.cart-item-info { flex: 1; display: flex; flex-direction: column; gap: 6px; }
.cart-item-name { display: flex; justify-content: space-between; gap: 6px; font-weight: 700; }
.item-controls { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.qty-box { display: inline-flex; align-items: center; gap: 8px; background: #f5f5f5; padding: 5px 8px; border-radius: 999px; }
.qty-box button { width: 24px; height: 24px; border-radius: 50%; background: white; font-weight: 800; color: var(--text); }
.totals-box { display: grid; gap: 10px; padding-top: 12px; border-top: 1px solid rgba(31, 31, 31, 0.06); }
.row { display: flex; justify-content: space-between; align-items: center; }
.row.total { font-size: 1.15rem; font-weight: 800; }
.payment-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.pay-option { display: flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid rgba(31, 31, 31, 0.05); border-radius: 12px; padding: 10px 8px; background: #fff; font-weight: 600; }
.pay-option input { accent-color: var(--brand); }
.checkout-btn { width: 100%; margin-top: auto; }
.modal { position: fixed; inset: 0; background: rgba(15, 15, 15, 0.52); display: grid; place-items: center; padding: 24px; z-index: 20; }
.modal.hidden { display: none; }
.modal-card { position: relative; background: white; width: min(520px, 100%); border-radius: 28px; padding: 24px 20px 20px; box-shadow: var(--shadow); }
.modal-card h3 { margin: 0 0 16px; font-size: 1.7rem; }
.close-btn { position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; border-radius: 8px; background: #f5f5f5; font-size: 1.2rem; }
#checkoutForm { display: grid; gap: 14px; }
.field-row { display: grid; gap: 8px; }
.field-row.two-col { grid-template-columns: 1.5fr 0.9fr; }
label { display: grid; gap: 8px; font-weight: 600; color: var(--text); }
input, textarea { border: 1px solid rgba(31, 31, 31, 0.08); background: #f9f9f9; border-radius: 12px; padding: 12px 14px; outline: none; }
input:focus, textarea:focus { border-color: rgba(255, 107, 44, 0.4); box-shadow: 0 0 0 4px rgba(255, 107, 44, 0.08); }
.submit-btn { width: 100%; margin-top: 8px; }
.toast { position: fixed; right: 24px; bottom: 24px; background: #1d1d1d; color: white; padding: 12px 16px; border-radius: 12px; box-shadow: var(--shadow); opacity: 0; transform: translateY(12px); transition: 0.25s ease; pointer-events: none; z-index: 30; }
.toast.show { opacity: 1; transform: translateY(0); }
.empty-state {
  background: #fff; border: 1px dashed rgba(31, 31, 31, 0.14); border-radius: 18px; padding: 24px 18px; text-align: center; color: var(--muted);
}
@media (max-width: 1200px) {
  .app-shell { grid-template-columns: 220px minmax(0, 1fr); }
  .cart-panel { grid-column: 1 / -1; }
}
@media (max-width: 900px) {
  .app-shell { grid-template-columns: 1fr; }
  .restaurant-list, .food-grid, .stats-panel { grid-template-columns: 1fr 1fr; }
  .hero { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .topbar, .section-header { flex-direction: column; align-items: stretch; }
  .restaurant-list, .food-grid, .stats-panel, .field-row.two-col, .payment-options { grid-template-columns: 1fr; }
  .app-shell { padding: 12px; }
  .main-panel, .sidebar, .cart-panel { border-radius: 22px; }
}
`;

const js = `const state = {
  restaurants: [],
  selectedRestaurantId: 1,
  activeCategory: 'Todos',
  cart: [],
  orderMode: 'delivery',
  paymentMethod: 'card'
};

const categories = ['Todos', 'Burgers', 'Pizza', 'Japonesa', 'Bebidas', 'Sobremesa', 'Acompanhamentos', 'Rolls'];

const formatCurrency = (value) =>
  new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);

const getSelectedRestaurant = () =>
  state.restaurants.find((restaurant) => restaurant.id === state.selectedRestaurantId) || state.restaurants[0];

const fetchRestaurants = async () => {
  try {
    const response = await fetch('/api/restaurants');
    const restaurants = await response.json();
    state.restaurants = restaurants;
    if (!state.selectedRestaurantId && restaurants.length) {
      state.selectedRestaurantId = restaurants[0].id;
    }
    renderCategories();
    renderRestaurants();
    fetchMenu();
  } catch (error) {
    console.error(error);
    showToast('Erro ao carregar os restaurantes.');
  }
};

const fetchMenu = async () => {
  const restaurant = getSelectedRestaurant();
  if (!restaurant) return;

  try {
    const response = await fetch(`/api/restaurants/${restaurant.id}/menu`);
    const items = await response.json();
    state.menuItems = items;
    renderFood();
  } catch (error) {
    console.error(error);
    showToast('Erro ao carregar o cardápio.');
  }
};

const getFilteredItems = () => {
  const items = state.menuItems || [];
  if (state.activeCategory === 'Todos') return items;
  return items.filter((item) => item.category === state.activeCategory);
};

const renderCategories = () => {
  const strip = document.getElementById('categoryStrip');
  strip.innerHTML = categories
    .map(
      (category) => `
        <button class="category-pill ${category === state.activeCategory ? 'active' : ''}" data-category="${category}">
          ${category}
        </button>
      `
    )
    .join('');
};

const renderRestaurants = () => {
  const list = document.getElementById('restaurantList');
  list.innerHTML = state.restaurants
    .map(
      (restaurant) => `
        <button class="restaurant-card ${restaurant.id === state.selectedRestaurantId ? 'active' : ''}" data-restaurant-id="${restaurant.id}">
          <div class="restaurant-cover" style="background-image: url('${restaurant.image}')">
            <span class="rating">★ ${restaurant.rating}</span>
          </div>
          <div class="restaurant-card-body">
            <h4>${restaurant.name}</h4>
            <div class="restaurant-meta">
              <span>${restaurant.cuisine}</span>
              <span>${restaurant.eta}</span>
            </div>
          </div>
        </button>
      `
    )
    .join('');
};

const renderFood = () => {
  const grid = document.getElementById('foodGrid');
  const restaurant = getSelectedRestaurant();
  const title = document.getElementById('catalogTitle');
  title.textContent = `${restaurant?.name || 'Restaurante'} • Menu`;

  const items = getFilteredItems();
  if (!items.length) {
    grid.innerHTML = '<div class="empty-state">Nenhum item encontrado nesta categoria.</div>';
    return;
  }

  grid.innerHTML = items
    .map(
      (item) => `
        <article class="food-card">
          <div class="food-image" style="background-image: url('${item.image}')"></div>
          <div class="food-body">
            <div class="food-top">
              <h4>${item.name}</h4>
              <span class="tag">${item.tag}</span>
            </div>
            <div class="food-meta">
              <span>${item.category}</span>
              <span>${item.calories}</span>
            </div>
            <div class="food-footer">
              <span class="price">${formatCurrency(item.price)}</span>
              <button class="add-btn" data-food-id="${item.id}">Adicionar</button>
            </div>
          </div>
        </article>
      `
    )
    .join('');
};

const renderCart = () => {
  const cartItems = document.getElementById('cartItems');
  const cartCount = document.getElementById('cartCount');
  const subtotalEl = document.getElementById('subtotal');
  const shippingEl = document.getElementById('shipping');
  const totalEl = document.getElementById('total');

  if (!state.cart.length) {
    cartItems.innerHTML = '<div class="empty-state">Seu carrinho está vazio. Escolha um prato para começar.</div>';
    cartCount.textContent = '0 itens';
    subtotalEl.textContent = formatCurrency(0);
    shippingEl.textContent = formatCurrency(0);
    totalEl.textContent = formatCurrency(0);
    return;
  }

  cartItems.innerHTML = state.cart
    .map(
      (item) => `
        <div class="cart-item">
          <div class="cart-thumb" style="background-image: url('${item.image}')"></div>
          <div class="cart-item-info">
            <div class="cart-item-name">
              <span>${item.name}</span>
              <strong>${formatCurrency(item.price * item.quantity)}</strong>
            </div>
            <div class="item-controls">
              <div class="qty-box">
                <button data-action="decrement" data-food-id="${item.id}">−</button>
                <span>${item.quantity}</span>
                <button data-action="increment" data-food-id="${item.id}">+</button>
              </div>
              <strong>${formatCurrency(item.price)}</strong>
            </div>
          </div>
        </div>
      `
    )
    .join('');

  const subtotal = state.cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
  const shipping = state.orderMode === 'delivery' ? 7.9 : 0;
  const total = subtotal + shipping;

  cartCount.textContent = `${state.cart.reduce((sum, item) => sum + item.quantity, 0)} itens`;
  subtotalEl.textContent = formatCurrency(subtotal);
  shippingEl.textContent = formatCurrency(shipping);
  totalEl.textContent = formatCurrency(total);
};

const addToCart = (foodId) => {
  const item = state.menuItems.find((food) => food.id === Number(foodId));
  if (!item) return;

  const existing = state.cart.find((entry) => entry.id === item.id);
  if (existing) {
    existing.quantity += 1;
  } else {
    state.cart.push({ ...item, quantity: 1 });
  }

  renderCart();
  showToast(`${item.name} adicionado ao pedido!`);
};

const updateQty = (foodId, delta) => {
  const index = state.cart.findIndex((entry) => entry.id === Number(foodId));
  if (index === -1) return;

  state.cart[index].quantity += delta;
  if (state.cart[index].quantity <= 0) state.cart.splice(index, 1);
  renderCart();
};

const setMode = (mode) => {
  state.orderMode = mode;
  document.querySelectorAll('.mode-btn').forEach((button) => {
    button.classList.toggle('active', button.dataset.mode === mode);
  });
  renderCart();
};

const updatePaymentMethod = (value) => {
  state.paymentMethod = value;
};

const openCheckout = () => {
  if (!state.cart.length) {
    showToast('Adicione pelo menos um item antes de finalizar.');
    return;
  }
  document.getElementById('checkoutModal').classList.remove('hidden');
};

const closeCheckout = () => {
  document.getElementById('checkoutModal').classList.add('hidden');
};

const showToast = (message) => {
  const toast = document.getElementById('toast');
  toast.textContent = message;
  toast.classList.add('show');
  clearTimeout(window.toastTimer);
  window.toastTimer = setTimeout(() => {
    toast.classList.remove('show');
  }, 1800);
};

const placeOrder = async () => {
  if (!state.cart.length) {
    showToast('Carrinho vazio.');
    return;
  }

  const restaurant = getSelectedRestaurant();
  const payload = {
    restaurantId: restaurant.id,
    items: state.cart.map((item) => ({
      id: item.id,
      name: item.name,
      price: item.price,
      quantity: item.quantity,
      image: item.image
    })),
    paymentMethod: state.paymentMethod,
    deliveryMode: state.orderMode,
    customer: {
      name: 'Maria Santos',
      address: 'Rua das Flores, 123, Centro'
    }
  };

  try {
    const response = await fetch('/api/orders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      throw new Error('Falha ao criar pedido');
    }

    const order = await response.json();
    state.cart = [];
    renderCart();
    closeCheckout();
    showToast(`Pedido #${order.id} confirmado!`);
    startTracking(order);
  } catch (error) {
    console.error(error);
    showToast('Não foi possível confirmar o pedido.');
  }
};

const startTracking = (order) => {
  const dashboard = document.querySelector('.stats-panel');
  const orderSteps = ['Pedido recebido', 'Preparando no restaurante', 'Saindo para entrega', 'Entregador a caminho', 'Pedido entregue'];

  dashboard.innerHTML = `
    <div class="stat-card"><span>Pedido</span><strong>#${order.id}</strong></div>
    <div class="stat-card"><span>Restaurante</span><strong>${order.restaurant}</strong></div>
    <div class="stat-card"><span>Modo</span><strong>${order.deliveryMode === 'delivery' ? 'Entrega' : 'Retirada'}</strong></div>
    <div class="stat-card"><span>Status</span><strong>${orderSteps[0]}</strong></div>
  `;

  let step = 0;
  const interval = setInterval(() => {
    step += 1;
    const currentStatus = orderSteps[Math.min(step, orderSteps.length - 1)];
    const statusCard = dashboard.querySelectorAll('.stat-card')[3];
    if (statusCard) statusCard.innerHTML = `<span>Status</span><strong>${currentStatus}</strong>`;
    if (step >= orderSteps.length - 1) clearInterval(interval);
  }, 3500);
};

const bindEvents = () => {
  document.getElementById('searchInput').addEventListener('input', (event) => {
    const query = event.target.value.toLowerCase();
    if (!state.restaurants.length) return;
    const filtered = state.restaurants.filter((restaurant) =>
      restaurant.name.toLowerCase().includes(query) || restaurant.cuisine.toLowerCase().includes(query)
    );

    const list = document.getElementById('restaurantList');
    list.innerHTML = filtered.length
      ? filtered
          .map(
            (restaurant) => `
              <button class="restaurant-card ${restaurant.id === state.selectedRestaurantId ? 'active' : ''}" data-restaurant-id="${restaurant.id}">
                <div class="restaurant-cover" style="background-image: url('${restaurant.image}')">
                  <span class="rating">★ ${restaurant.rating}</span>
                </div>
                <div class="restaurant-card-body">
                  <h4>${restaurant.name}</h4>
                  <div class="restaurant-meta">
                    <span>${restaurant.cuisine}</span>
                    <span>${restaurant.eta}</span>
                  </div>
                </div>
              </button>
            `
          )
          .join('')
      : '<div class="empty-state">Nenhum restaurante encontrado.</div>';
  });

  document.getElementById('categoryStrip').addEventListener('click', (event) => {
    const button = event.target.closest('[data-category]');
    if (!button) return;
    state.activeCategory = button.dataset.category;
    renderCategories();
    renderFood();
  });

  document.getElementById('restaurantList').addEventListener('click', (event) => {
    const card = event.target.closest('[data-restaurant-id]');
    if (!card) return;
    state.selectedRestaurantId = Number(card.dataset.restaurantId);
    renderRestaurants();
    fetchMenu();
  });

  document.getElementById('foodGrid').addEventListener('click', (event) => {
    const button = event.target.closest('[data-food-id]');
    if (!button) return;
    addToCart(button.dataset.foodId);
  });

  document.getElementById('cartItems').addEventListener('click', (event) => {
    const button = event.target.closest('[data-action]');
    if (!button) return;
    const action = button.dataset.action;
    const foodId = Number(button.dataset.foodId);
    if (action === 'increment') updateQty(foodId, 1);
    if (action === 'decrement') updateQty(foodId, -1);
  });

  document.querySelectorAll('.mode-btn').forEach((button) => {
    button.addEventListener('click', () => setMode(button.dataset.mode));
  });

  document.querySelectorAll('input[name="paymentMethod"]').forEach((input) => {
    input.addEventListener('change', (event) => updatePaymentMethod(event.target.value));
  });

  document.getElementById('checkoutBtn').addEventListener('click', openCheckout);
  document.getElementById('closeModal').addEventListener('click', closeCheckout);
  document.getElementById('checkoutModal').addEventListener('click', (event) => {
    if (event.target.id === 'checkoutModal') closeCheckout();
  });

  document.getElementById('checkoutForm').addEventListener('submit', (event) => {
    event.preventDefault();
    placeOrder();
  });
};

async function init() {
  bindEvents();
  renderCategories();
  renderCart();
  await fetchRestaurants();
}

init();
`;

fs.writeFileSync(path.join(publicDir, 'index.html'), html);
fs.writeFileSync(path.join(publicDir, 'styles.css'), css);
fs.writeFileSync(path.join(publicDir, 'app.js'), js);

console.log('Public assets generated successfully.');
